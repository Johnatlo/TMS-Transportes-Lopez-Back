# =============================================================================
# Variables de PRODUCCION para Docker (docker-compose.yml).
#
# Copia este archivo a .env.production y llenalo. .env.production NUNCA se
# sube al repositorio (esta en .gitignore): lleva claves reales.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production up -d --build
#
# DB_HOST, DB_PORT, PORT y TRUST_PROXY no van aqui: los fija docker-compose.yml.
#
# Si una clave tiene el signo $ (o espacios), escribela entre comillas SIMPLES
# para que Docker Compose la tome literal:  RNDC_PASSWORD='abc$123'

# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (contenedor mysql)
# -----------------------------------------------------------------------------
DB_NAME=rndc_tms
DB_USER=tms
# Contrasena larga y aleatoria. Solo se usa dentro de Docker.
DB_PASSWORD=
# Clave del usuario root de MySQL (restaurar respaldos, mantenimiento).
MYSQL_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Acceso web (contenedor caddy)
# -----------------------------------------------------------------------------
# IP donde escucha el puerto web. Vacio = todas las interfaces. Para que SOLO
# se entre por Tailscale, pon la IP de Tailscale del equipo (tailscale ip -4).
HTTP_BIND=
HTTP_PORT=80
# Carpeta del frontend compilado, relativa a este directorio.
FRONTEND_DIST_HOST=../frontend-react/dist

# -----------------------------------------------------------------------------
# Empresa (encabezado de la remesa impresa)
# -----------------------------------------------------------------------------
EMPRESA_NOMBRE=
EMPRESA_DIRECCION=
EMPRESA_TELEFONO=
EMPRESA_MUNICIPIO=

# -----------------------------------------------------------------------------
# RNDC (Ministerio de Transporte)
# -----------------------------------------------------------------------------
# Usuario del webservice y NIT de la empresa, sin puntos ni digito de verificacion.
RNDC_USUARIO=
RNDC_PASSWORD=
RNDC_EMPRESA_NIT=

# pruebas | produccion
RNDC_AMBIENTE=pruebas
# true = no se envia nada al Ministerio. Para operar de verdad: false.
RNDC_SIMULAR=true
# Freno de mano: con RNDC_AMBIENTE=produccion y RNDC_SIMULAR=false el backend
# NO arranca sin esta frase exacta. La escribe la persona responsable:
#   RNDC_CONFIRMO_PRODUCCION="SI, EXPEDIR DOCUMENTOS REALES"
RNDC_CONFIRMO_PRODUCCION=

# NIT de la empresa de monitoreo (GPS) por defecto, si el vehiculo no tiene una.
RNDC_NIT_MONITOREO_FLOTA=

# Numeracion de remesas y manifiestos.
RNDC_LONGITUD_CONSECUTIVO=8
RNDC_PREFIJO_CONSECUTIVO=
# Ultimo numero usado FUERA del sistema (portal del RNDC). El siguiente que se
# sugiere nunca queda por debajo de este.
RNDC_ULTIMO_CONSECUTIVO=

# Reintentos ante fallas de RED al hablar con el RNDC (no ante rechazos).
RNDC_REINTENTOS=1

# Solo para cambiar a mano las URL del RNDC. Normalmente se dejan vacias: el
# ambiente elegido arriba ya define la correcta.
RNDC_WSDL_URL=
RNDC_CONSULTAS_WSDL_URL=
RNDC_REST_URL=

# -----------------------------------------------------------------------------
# SICETAC (piso tarifario)
# -----------------------------------------------------------------------------
SICETAC_UNIDAD_TRANSPORTE=ESTACAS
SICETAC_TIPO_CARGA="Granel Solido"
SICETAC_MESES_ATRAS=3

# -----------------------------------------------------------------------------
# Correo (Gmail): recuperar contrasena y enviar claves temporales
# -----------------------------------------------------------------------------
# SMTP_CLAVE es una CONTRASENA DE APLICACION de Google
# (myaccount.google.com/apppasswords), no la contrasena normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=

# -----------------------------------------------------------------------------
# Opcionales
# -----------------------------------------------------------------------------
# Solo aplica si el frontend se sirve desde otro origen; con Caddy no hace falta.
CORS_ORIGIN=
# Ruta (dentro del contenedor) de otro logo para los documentos impresos.
LOGO_EMPRESA=

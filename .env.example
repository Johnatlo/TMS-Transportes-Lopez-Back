# ---------------------------------------------------------------------------
# Conexion a MySQL / MariaDB
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=rndc_app
DB_PASSWORD=cambia_esta_clave
DB_NAME=rndc_tms

PORT=3000

# Nombre de la empresa, solo para encabezar los documentos que ella imprime.
EMPRESA_NOMBRE="Transportes Lopez C S.A.S"

# Origen permitido para CORS (URL del frontend Angular)
CORS_ORIGIN="http://localhost:4200"

# ---------------------------------------------------------------------------
# Ambiente del RNDC
# ---------------------------------------------------------------------------
# "pruebas"    -> http://plc.mintransporte.gov.co:8080/ws
#                 Copia de la base de produccion de una fecha pasada. Lo que
#                 registres aqui no tiene efecto legal.
# "produccion" -> http://rndcws.mintransporte.gov.co:8080/ws
#                 Documentos reales.
#
# OJO: el usuario y la contrasena son LOS MISMOS en los dos ambientes. Lo unico
# que separa una prueba de un manifiesto real es esta variable.
RNDC_AMBIENTE=pruebas

# Deja true mientras armas plantillas: no llama al RNDC, solo simula la
# respuesta y te deja ver el XML que se habria enviado.
RNDC_SIMULAR=true

# Freno de mano. Para expedir documentos REALES no basta con poner
# RNDC_AMBIENTE=produccion y RNDC_SIMULAR=false: hay que descomentar esto.
# RNDC_CONFIRMO_PRODUCCION="SI, EXPEDIR DOCUMENTOS REALES"

# URL del servicio REST que entrega el PDF del manifiesto. Es distinto del SOAP
# y va en otro puerto. Vacio = la del ambiente elegido arriba.
RNDC_REST_URL=

# Solo para sobrescribir la URL a mano (por ejemplo, para probar el servidor
# secundario de produccion: http://rndcws2.mintransporte.gov.co:8080/ws).
# Si la dejas vacia, se usa la del ambiente elegido arriba.
RNDC_WSDL_URL=

# ---------------------------------------------------------------------------
# Credenciales del RNDC
# ---------------------------------------------------------------------------
# Se recomienda un usuario TIPO 1 (dependiente), no el principal. El usuario
# principal (tipo 6) es el que le asigna a los tipo 1 su rango de consecutivos
# de manifiesto, desde Administrar Usuarios en el portal.
RNDC_USUARIO=""
RNDC_PASSWORD=""
RNDC_EMPRESA_NIT=""

# NIT de la empresa de monitoreo GPS de la flota (va en el manifiesto como
# NITMONITOREOFLOTA). Dejalo vacio si tu operacion no usa proveedor de GPS.
RNDC_NIT_MONITOREO_FLOTA=

# Reintentos ante fallas de red del RNDC (no aplica a rechazos del documento).
RNDC_REINTENTOS=1

# ---------------------------------------------------------------------------
# Consecutivos propios de remesa y manifiesto
# ---------------------------------------------------------------------------
# Deben ser unicos y nunca repetirse dentro de la empresa, y quedar dentro del
# rango que el usuario principal le asigno a este usuario en el portal.
# Por defecto se generan como REM{id}/MAN{id}. Si ya venias con una numeracion
# propia, usa estas variables para continuarla en vez de reiniciar en 1.
RNDC_PREFIJO_REMESA=REM
RNDC_INICIO_REMESA=0
RNDC_PREFIJO_MANIFIESTO=MAN
RNDC_INICIO_MANIFIESTO=0

# ---------------------------------------------------------------------------
# SICETAC
# ---------------------------------------------------------------------------
# SICETAC cotiza por combinacion de unidad de transporte y tipo de carga, y
# cada una tiene un piso distinto. Estos definen cual fila corresponde a la
# operacion de la empresa.
SICETAC_UNIDAD_TRANSPORTE=ESTACAS
SICETAC_TIPO_CARGA="Granel Solido"
# Meses hacia atras que se reintentan si el periodo actual no trae datos: un
# mes puede heredar los valores del anterior.
SICETAC_MESES_ATRAS=3

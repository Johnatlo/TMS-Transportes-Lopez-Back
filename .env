# Conexion a MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rndc_tms

PORT=3000

# Origen permitido para CORS (URL del frontend Angular)
CORS_ORIGIN="http://localhost:4200"

# Credenciales del RNDC (te las entrega el Ministerio de Transporte)
RNDC_WSDL_URL="http://rndcws.mintransporte.gov.co:8080/ws/WebInterface.asmx?WSDL"
RNDC_USUARIO=""
RNDC_PASSWORD=""
RNDC_EMPRESA_NIT=""

# true mientras desarrollas (no llama al RNDC real, solo simula la respuesta)
RNDC_SIMULAR=true

# NIT de la empresa de monitoreo GPS de la flota (opcional, va en el manifiesto
# como NITMONITOREOFLOTA si tu operacion usa un proveedor de GPS)
RNDC_NIT_MONITOREO_FLOTA=

# Consecutivos propios de remesa/manifiesto (deben ser unicos y no repetirse).
# Por defecto se generan como REM{id}/MAN{id}. Si tu empresa ya tenia una
# numeracion en uso (por ejemplo viniendo de Excel), usa estas variables para
# continuarla en vez de reiniciar en 1.
RNDC_PREFIJO_REMESA=REM
RNDC_INICIO_REMESA=0
RNDC_PREFIJO_MANIFIESTO=MAN
RNDC_INICIO_MANIFIESTO=0
